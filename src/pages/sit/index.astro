---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase, absoluteUrl } from '../../lib/site';
import { verseForDay } from '../../lib/verses';

const featured = verseForDay(new Date());
const description =
  'A quiet minute to sit with Jesus — today’s verse, a short breath prayer, and gentle next steps.';

const sitJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Sit with Jesus',
  url: absoluteUrl('sit/'),
  description,
  isPartOf: {
    '@type': 'WebSite',
    name: 'Walking with Jesus',
    url: absoluteUrl(),
  },
};
---
<BaseLayout title="Sit with Jesus" description={description} jsonLd={sitJsonLd}>
  <article class="sit-page">
    <div class="sit-room">
      <div class="sit-vignette" aria-hidden="true"></div>
      <header class="sit-header">
        <p class="sit-kicker">A still room</p>
        <h1>Sit with Jesus</h1>
        <p class="sit-lead">
          For about a minute — sixty to ninety seconds — set the phone aside.
          You do not need to fix anything. Just be here.
        </p>
      </header>

      <section class="sit-verse" aria-label="Today’s verse">
        <div class="verse-ornament sit-ornament" aria-hidden="true">
          <span class="verse-ornament-line"></span>
          <span class="verse-ornament-mark">†</span>
          <span class="verse-ornament-line"></span>
        </div>
        <blockquote>
          <p>“{featured.text}”</p>
          <footer>
            <cite>{featured.reference}</cite>
            <span class="verse-hero-credit">World English Bible</span>
          </footer>
        </blockquote>
      </section>

      <section class="sit-pause" aria-labelledby="sit-pause-heading">
        <h2 id="sit-pause-heading">Breathe with Him</h2>
        <div class="sit-breathe-line" aria-hidden="true">
          <span class="sit-breathe-pulse"></span>
        </div>
        <p class="sit-breath">
          Inhale: <em>Jesus, You are here.</em><br />
          Exhale: <em>I am with You.</em>
        </p>
        <p class="sit-note">
          Repeat slowly a few times. Let the verse rest on you like light on water.
          If your mind wanders, return gently — He is not impatient.
        </p>
      </section>
    </div>

    <nav class="sit-links" aria-label="Continue from here">
      <a class="path-card path-sit" href={withBase('pray/')}>
        <span class="path-icon" aria-hidden="true">P</span>
        <span class="path-kicker">Pray</span>
        <strong>A written prayer</strong>
        <span class="path-note">When you want words waiting for you.</span>
      </a>
      <a class="path-card path-hard" href={withBase('hard-times/')}>
        <span class="path-icon" aria-hidden="true">H</span>
        <span class="path-kicker">Hard times</span>
        <strong>Start where it hurts</strong>
        <span class="path-note">A short verse for anxiety, grief, fear, and more.</span>
      </a>
      <a class="path-card path-readings" href={withBase('readings/abide-in-me/')}>
        <span class="path-icon" aria-hidden="true">R</span>
        <span class="path-kicker">Reading</span>
        <strong>Abide in Me</strong>
        <span class="path-note">Sit longer with Jesus’ words in John 15.</span>
      </a>
    </nav>

    <p class="sit-home">
      <a href={withBase()}>← Back home</a>
    </p>
  </article>
</BaseLayout>
