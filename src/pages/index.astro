---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase, defaultDescription, siteName, absoluteUrl } from '../lib/site';
import { verseForDay } from '../lib/verses';
import { quotes, quoteForDay } from '../data/quotes';
import { readingTimeLabel } from '../lib/readingTime';
import {
  comparePostsDayOrder,
  comparePostsLatestFirst,
  formatDate,
  isoDate,
  slotLabel,
  slugifyTag,
} from '../lib/posts';

const allPosts = (await getCollection('posts')).sort(comparePostsLatestFirst);
const todayKey = isoDate(new Date());
const todaysPosts = allPosts
  .filter((post) => isoDate(post.data.pubDate) === todayKey)
  .sort(comparePostsDayOrder);

const recentPosts = allPosts.slice(0, 6);
const hasMore = allPosts.length > 6;
const featured = verseForDay(new Date());
const quoteOfDay = quoteForDay(new Date());
const todayHref = todaysPosts.length > 0 ? '#today-heading' : withBase('archive/');

const feelingChips = [
  { label: 'Anxious', tag: 'anxiety', mood: 'anxiety' },
  { label: 'Afraid', tag: 'fear', mood: 'fear' },
  { label: 'Grieving', tag: 'grief', mood: 'grief' },
  { label: 'Lonely', tag: 'loneliness', mood: 'loneliness' },
  { label: 'Exhausted', tag: 'exhaustion', mood: 'exhaustion' },
  { label: 'Doubting', tag: 'doubt', mood: 'doubt' },
  { label: 'Ashamed', tag: 'shame', mood: 'shame' },
  { label: 'Waiting', tag: 'waiting', mood: 'waiting' },
  { label: 'Sick', tag: 'sickness', mood: 'sickness' },
  { label: 'Worried about money', tag: 'money', mood: 'money' },
];

function bodyText(post: (typeof allPosts)[number]): string {
  return typeof post.body === 'string' ? post.body : '';
}

const homeJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteName,
    url: absoluteUrl(),
    description: defaultDescription,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: siteName,
    url: absoluteUrl(),
    description: defaultDescription,
  },
];
---
<BaseLayout title={siteName} description={defaultDescription} jsonLd={homeJsonLd}>
  <section class="verse-hero" aria-labelledby="verse-hero-heading">
    <p class="verse-hero-kicker" id="verse-hero-heading">Word for today</p>
    <div class="verse-ornament" aria-hidden="true">
      <span class="verse-ornament-line"></span>
      <span class="verse-ornament-mark">†</span>
      <span class="verse-ornament-line"></span>
    </div>
    <blockquote class="verse-hero-quote">
      <p>“{featured.text}”</p>
      <footer>
        <cite>{featured.reference}</cite>
        <span class="verse-hero-credit">World English Bible</span>
      </footer>
    </blockquote>
    <p class="verse-hero-invite">Come as you are. He is already near.</p>
  </section>


  <section
    class="qotd"
    id="quote-of-the-day"
    aria-labelledby="qotd-heading"
    data-qotd
  >
    <p class="qotd-kicker" id="qotd-heading">Quote of the day</p>
    <blockquote class="qotd-quote">
      <p data-qotd-text>“{quoteOfDay.quote}”</p>
    </blockquote>
    <footer class="qotd-meta">
      <p class="qotd-attribution">
        <strong data-qotd-person>{quoteOfDay.person}</strong>
        <span class="meta-sep" data-qotd-year-sep aria-hidden="true" hidden={quoteOfDay.year == null}>·</span>
        <span class="quote-year" data-qotd-year hidden={quoteOfDay.year == null}>
          {quoteOfDay.year}
        </span>
      </p>
      <p class="qotd-links">
        <a
          data-qotd-source
          href={quoteOfDay.sourceUrl}
          rel="noopener noreferrer"
        >
          {quoteOfDay.sourceTitle}
        </a>
        <span class="meta-sep" aria-hidden="true">·</span>
        <a href={withBase('quotes/')}>More quotes</a>
      </p>
    </footer>
    <p class="qotd-disclaimer">
      Not an endorsement of everything they say or do — a window toward Jesus.
    </p>
  </section>

  <script define:vars={{ quotesPool: quotes }}>
    (function () {
      var root = document.querySelector('[data-qotd]');
      if (!root || !Array.isArray(quotesPool) || quotesPool.length === 0) return;

      function dayIndexForDate(date) {
        var start = new Date(date.getFullYear(), 0, 1);
        var current = new Date(date.getFullYear(), date.getMonth(), date.getDate());
        return Math.floor((current.getTime() - start.getTime()) / 86400000);
      }

      var pick = quotesPool[dayIndexForDate(new Date()) % quotesPool.length];
      var textEl = root.querySelector('[data-qotd-text]');
      var personEl = root.querySelector('[data-qotd-person]');
      var yearEl = root.querySelector('[data-qotd-year]');
      var sourceEl = root.querySelector('[data-qotd-source]');

      if (textEl) textEl.textContent = '\u201C' + pick.quote + '\u201D';
      if (personEl) personEl.textContent = pick.person;
      var yearSep = root.querySelector('[data-qotd-year-sep]');
      if (yearEl) {
        if (pick.year != null) {
          yearEl.textContent = String(pick.year);
          yearEl.hidden = false;
          if (yearSep) yearSep.hidden = false;
        } else {
          yearEl.textContent = '';
          yearEl.hidden = true;
          if (yearSep) yearSep.hidden = true;
        }
      }
      if (sourceEl) {
        sourceEl.href = pick.sourceUrl;
        sourceEl.textContent = pick.sourceTitle;
      }
    })();
  </script>

  <section class="feeling-strip" aria-labelledby="feeling-heading">
    <div class="feeling-intro">
      <h2 id="feeling-heading">How are you?</h2>
      <p class="feeling-prompt">Start where it hurts.</p>
    </div>
    <ul class="feeling-chips" role="list">
      {feelingChips.map((chip) => (
        <li>
          <a class={`feeling-chip mood-${chip.mood}`} href={withBase(`hard-times/${chip.tag}/`)}>{chip.label}</a>
        </li>
      ))}
    </ul>
  </section>

  {todaysPosts.length > 0 && (
    <section class="today-section" aria-labelledby="today-heading">
      <h2 id="today-heading">Today’s reflections</h2>
      <ul class="post-list today-list">
        {todaysPosts.map((post) => {
          const label = slotLabel(post.data.slot);
          const minutes = readingTimeLabel(bodyText(post));
          return (
            <li class="post-card today-card">
              <div class="card-top">
                {label && <span class={`slot-badge slot-${post.data.slot}`}>{label}</span>}
                <span class="meta reading-inline">{minutes}</span>
              </div>
              <h3>
                <a href={withBase(`posts/${post.slug}/`)}>{post.data.title}</a>
              </h3>
              {post.data.scripture && <p class="scripture-inline">{post.data.scripture}</p>}
              <p class="excerpt">{post.data.description}</p>
              {(post.data.tags?.length ?? 0) > 0 && (
                <ul class="tag-list compact" aria-label="Tags">
                  {post.data.tags!.map((tag) => (
                    <li>
                      <a class="tag-chip" href={withBase(`tags/${slugifyTag(tag)}/`)}>{tag}</a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          );
        })}
      </ul>
    </section>
  )}

  <section class="explore-section" aria-labelledby="explore-heading">
    <h2 id="explore-heading">Explore</h2>
    <div class="home-paths home-ctas" aria-label="Ways to go deeper">
      <a class="path-card path-learn" href={withBase('learn/')}>
        <span class="path-kicker">Learn</span>
        <strong>Simple lessons</strong>
        <span class="path-note">A short school of walking with Jesus — no rush.</span>
      </a>
      <a class="path-card path-stories" href={withBase('stories/')}>
        <span class="path-kicker">Stories</span>
        <strong>Heart-change stories</strong>
        <span class="path-note">21st-century and historical heart-change stories — every one sourced.</span>
      </a>
      <a class="path-card path-sit" href={withBase('sit/')}>
        <span class="path-kicker">Pause</span>
        <strong>Sit with Jesus</strong>
        <span class="path-note">A quiet minute with today’s word.</span>
      </a>
      <a class="path-card path-hard" href={withBase('hard-times/')}>
        <span class="path-kicker">Hard times</span>
        <strong>Start where it hurts</strong>
        <span class="path-note">A short verse for anxiety, grief, fear, and more.</span>
      </a>
    </div>
  </section>

  <p class="home-quiet-links eyebrow">
    <a href={withBase('start-here/')}>Start here</a>
    · <a href={todayHref}>Today</a>
    · <a href={withBase('pray/')}>Pray</a>
    · <a href={withBase('quotes/')}>Quotes</a>
    · <a href={withBase('more/')}>More</a>
  </p>

  <section class="recent-section" aria-labelledby="recent-heading">
    <div class="section-heading-row">
      <h2 id="recent-heading">Recent reflections</h2>
      {hasMore && (
        <a class="section-link" href={withBase('archive/')}>View archive →</a>
      )}
    </div>
    <ul class="post-list">
      {recentPosts.map((post) => {
        const date = formatDate(post.data.pubDate);
        const label = slotLabel(post.data.slot);
        const minutes = readingTimeLabel(bodyText(post));
        return (
          <li class="post-card">
            <h3>
              <a href={withBase(`posts/${post.slug}/`)}>{post.data.title}</a>
            </h3>
            <p class="meta">
              <time datetime={isoDate(post.data.pubDate)}>{date}</time>
              {label && (
                <>
                  <span class="meta-sep" aria-hidden="true">·</span>
                  <span class={`slot-badge slot-${post.data.slot}`}>{label}</span>
                </>
              )}
              <span class="meta-sep" aria-hidden="true">·</span>
              <span>{minutes}</span>
            </p>
            {(post.data.tags?.length ?? 0) > 0 && (
              <ul class="tag-list compact" aria-label="Tags">
                {post.data.tags!.map((tag) => (
                  <li>
                    <a class="tag-chip" href={withBase(`tags/${slugifyTag(tag)}/`)}>{tag}</a>
                  </li>
                ))}
              </ul>
            )}
            <p class="excerpt">{post.data.description}</p>
          </li>
        );
      })}
    </ul>
    {hasMore && (
      <p class="archive-cta">
        <a href={withBase('archive/')}>Browse the full archive</a>
      </p>
    )}
  </section>
</BaseLayout>
