---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase, defaultDescription, siteName, absoluteUrl } from '../lib/site';
import { verseForDay } from '../lib/verses';
import { readingTimeLabel } from '../lib/readingTime';
import {
  comparePostsDayOrder,
  comparePostsLatestFirst,
  formatDate,
  isoDate,
  slotLabel,
  slugifyTag,
} from '../lib/posts';

const allPosts = (await getCollection('posts')).sort(comparePostsLatestFirst);
const todayKey = isoDate(new Date());
const todaysPosts = allPosts
  .filter((post) => isoDate(post.data.pubDate) === todayKey)
  .sort(comparePostsDayOrder);

const recentPosts = allPosts.slice(0, 6);
const hasMore = allPosts.length > 6;
const featured = verseForDay(new Date());
const todayHref = todaysPosts.length > 0 ? '#today-heading' : withBase('archive/');

const feelingChips = [
  { label: 'Anxious', tag: 'anxiety' },
  { label: 'Afraid', tag: 'fear' },
  { label: 'Grieving', tag: 'grief' },
  { label: 'Lonely', tag: 'loneliness' },
  { label: 'Exhausted', tag: 'exhaustion' },
  { label: 'Doubting', tag: 'doubt' },
  { label: 'Ashamed', tag: 'shame' },
  { label: 'Waiting', tag: 'waiting' },
  { label: 'Sick', tag: 'sickness' },
  { label: 'Worried about money', tag: 'money' },
];

function bodyText(post: (typeof allPosts)[number]): string {
  return typeof post.body === 'string' ? post.body : '';
}

const homeJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteName,
    url: absoluteUrl(),
    description: defaultDescription,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: siteName,
    url: absoluteUrl(),
    description: defaultDescription,
  },
];
---
<BaseLayout title={siteName} description={defaultDescription} jsonLd={homeJsonLd}>
  <section class="verse-hero" aria-labelledby="verse-hero-heading">
    <p class="verse-hero-kicker" id="verse-hero-heading">Word for today</p>
    <blockquote class="verse-hero-quote">
      <p>“{featured.text}”</p>
      <footer>
        <cite>{featured.reference}</cite>
        <span class="verse-hero-credit">World English Bible</span>
      </footer>
    </blockquote>
    <p class="verse-hero-invite">Come as you are. He is already near.</p>
  </section>

  <section class="feeling-strip" aria-labelledby="feeling-heading">
    <div class="feeling-intro">
      <h2 id="feeling-heading">How are you?</h2>
      <p class="feeling-prompt">Start where it hurts.</p>
    </div>
    <ul class="feeling-chips" role="list">
      {feelingChips.map((chip) => (
        <li>
          <a class="feeling-chip" href={withBase(`hard-times/${chip.tag}/`)}>{chip.label}</a>
        </li>
      ))}
    </ul>
  </section>

  {todaysPosts.length > 0 && (
    <section class="today-section" aria-labelledby="today-heading">
      <h2 id="today-heading">Today’s reflections</h2>
      <ul class="post-list today-list">
        {todaysPosts.map((post) => {
          const label = slotLabel(post.data.slot);
          const minutes = readingTimeLabel(bodyText(post));
          return (
            <li class="post-card today-card">
              <div class="card-top">
                {label && <span class={`slot-badge slot-${post.data.slot}`}>{label}</span>}
                <span class="meta reading-inline">{minutes}</span>
              </div>
              <h3>
                <a href={withBase(`posts/${post.slug}/`)}>{post.data.title}</a>
              </h3>
              {post.data.scripture && <p class="scripture-inline">{post.data.scripture}</p>}
              <p class="excerpt">{post.data.description}</p>
              {(post.data.tags?.length ?? 0) > 0 && (
                <ul class="tag-list compact" aria-label="Tags">
                  {post.data.tags!.map((tag) => (
                    <li>
                      <a class="tag-chip" href={withBase(`tags/${slugifyTag(tag)}/`)}>{tag}</a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          );
        })}
      </ul>
    </section>
  )}

  <div class="home-paths home-ctas" aria-label="Ways to go deeper">
    <a class="path-card" href={withBase('sit/')}>
      <span class="path-kicker">Pause</span>
      <strong>Sit with Jesus</strong>
      <span class="path-note">A quiet minute with today’s word.</span>
    </a>
    <a class="path-card" href={withBase('readings/')}>
      <span class="path-kicker">Readings</span>
      <strong>Longer readings</strong>
      <span class="path-note">Chapters of Jesus’ teaching to sit with slowly.</span>
    </a>
    <a class="path-card" href={withBase('pray/')}>
      <span class="path-kicker">Pray</span>
      <strong>Simple prayers</strong>
      <span class="path-note">Words when you do not have your own.</span>
    </a>
    <a class="path-card" href={withBase('faq/')}>
      <span class="path-kicker">FAQ</span>
      <strong>Common questions</strong>
      <span class="path-note">Gentle answers for seekers and the curious.</span>
    </a>
  </div>

  <p class="home-quiet-links eyebrow">
    <a href={withBase('start-here/')}>Start here</a>
    · <a href={todayHref}>Today</a>
    · <a href={withBase('share/')}>Share</a>
    · <a href={withBase('de/')} lang="de">Willkommen (DE)</a>
  </p>

  <section class="recent-section" aria-labelledby="recent-heading">
    <div class="section-heading-row">
      <h2 id="recent-heading">Recent reflections</h2>
      {hasMore && (
        <a class="section-link" href={withBase('archive/')}>View archive →</a>
      )}
    </div>
    <ul class="post-list">
      {recentPosts.map((post) => {
        const date = formatDate(post.data.pubDate);
        const label = slotLabel(post.data.slot);
        const minutes = readingTimeLabel(bodyText(post));
        return (
          <li class="post-card">
            <h3>
              <a href={withBase(`posts/${post.slug}/`)}>{post.data.title}</a>
            </h3>
            <p class="meta">
              <time datetime={isoDate(post.data.pubDate)}>{date}</time>
              {label && (
                <>
                  <span class="meta-sep" aria-hidden="true">·</span>
                  <span class={`slot-badge slot-${post.data.slot}`}>{label}</span>
                </>
              )}
              <span class="meta-sep" aria-hidden="true">·</span>
              <span>{minutes}</span>
            </p>
            {(post.data.tags?.length ?? 0) > 0 && (
              <ul class="tag-list compact" aria-label="Tags">
                {post.data.tags!.map((tag) => (
                  <li>
                    <a class="tag-chip" href={withBase(`tags/${slugifyTag(tag)}/`)}>{tag}</a>
                  </li>
                ))}
              </ul>
            )}
            <p class="excerpt">{post.data.description}</p>
          </li>
        );
      })}
    </ul>
    {hasMore && (
      <p class="archive-cta">
        <a href={withBase('archive/')}>Browse the full archive</a>
      </p>
    )}
  </section>
</BaseLayout>
