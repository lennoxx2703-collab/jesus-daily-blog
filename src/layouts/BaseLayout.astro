---
import '../styles/global.css';
import {
  withBase,
  siteName,
  defaultTagline,
  defaultDescription,
} from '../lib/site';

interface Props {
  title: string;
  description?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = defaultDescription,
  ogType = 'website',
  jsonLd,
} = Astro.props;
const year = new Date().getFullYear();
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogUrl = canonical.href;
const path = Astro.url.pathname;
const base = withBase().replace(/\/$/, '') || '';
const jsonLdBlocks = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : [];

function isActive(href: string): boolean {
  const target = withBase(href).replace(/\/$/, '') || '/';
  const current = path.replace(/\/$/, '') || '/';
  if (href === '' || href === '/') {
    return current === base || current === `${base}/` || current === '/jesus-daily-blog';
  }
  return current === target || current.startsWith(`${target}/`);
}

const primaryNav = [
  { href: '/', label: 'Home' },
  { href: 'learn/', label: 'Learn' },
  { href: 'hard-times/', label: 'Hard times' },
  { href: 'sit/', label: 'Sit' },
  { href: 'readings/', label: 'Readings' },
  { href: 'stories/', label: 'Stories' },
  { href: 'more/', label: 'More' },
];
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={siteName} href={withBase('rss.xml')} />

    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <div class="site-header-top">
          <div class="site-brand-block">
            <a class="site-brand" href={withBase()}>{siteName}</a>
            <p class="site-tagline">{defaultTagline}</p>
            <p class="site-invite-ribbon">
              <span class="invite-dot" aria-hidden="true"></span>
              Come as you are
            </p>
          </div>
          <details class="site-menu">
            <summary>Menu</summary>
            <nav class="site-menu-panel" aria-label="Mobile">
              {primaryNav.map((item) => (
                <a
                  href={withBase(item.href === '/' ? '' : item.href)}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              ))}
            </nav>
          </details>
        </div>
        <nav class="site-nav" aria-label="Main">
          {primaryNav.map((item) => (
            <a
              href={withBase(item.href === '/' ? '' : item.href)}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <main class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer-inner">
        <p class="verse">“I am the way, and the truth, and the life.” — John 14:6</p>
        <p>
          © {year} {siteName} ·
          <a href={withBase('rss.xml')}>RSS</a> ·
          <a href={withBase('share/')}>Share</a>
        </p>
        <nav class="footer-nav" aria-label="More destinations">
          <a href={withBase('start-here/')}>Start here</a>
          <a href={withBase('pray/')}>Pray</a>
          <a href={withBase('faq/')}>FAQ</a>
          <a href={withBase('archive/')}>Archive</a>
          <a href={withBase('about/')}>About</a>
          <a href={withBase('quotes/')}>Quotes</a>
          <a href={withBase('more/')}>More</a>
        </nav>
        <p class="footer-directory">
          <a
            href="https://www.faithfulbloggers.com/"
            rel="noopener noreferrer"
            class="faithful-bloggers-link"
          >
            <img
              src="https://images.squarespace-cdn.com/content/v1/58a4c0e703596ecca0c84d03/1488394030040-64NBY0WGOONK2MKQJK2G/badge2.png"
              alt="Faithful Bloggers"
              width="125"
              height="125"
              loading="lazy"
              decoding="async"
            />
          </a>
          <span>
            Listed with
            <a href="https://www.faithfulbloggers.com/" rel="noopener noreferrer">Faithful Bloggers</a>
          </span>
        </p>
      </div>
    </footer>
  </body>
</html>
