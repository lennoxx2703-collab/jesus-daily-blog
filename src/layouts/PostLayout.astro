---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
}

const { title, description, pubDate } = Astro.props;
const formatted = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---
<BaseLayout title={title} description={description}>
  <a class="back-link" href={`${import.meta.env.BASE_URL}`}>← All reflections</a>
  <article class="prose">
    <h1>{title}</h1>
    <p class="meta">
      <time datetime={pubDate.toISOString().slice(0, 10)}>{formatted}</time>
    </p>
    <slot />
  </article>
</BaseLayout>
